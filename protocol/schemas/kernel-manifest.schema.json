{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ckp.local/schemas/kernel-manifest.schema.json",
  "title": "CKP Kernel Manifest",
  "description": "CKP 1.0 内核清单（kernel.json）",
  "type": "object",
  "required": ["ckp", "id", "name", "version", "runtime", "capabilities"],
  "additionalProperties": true,
  "properties": {
    "ckp": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "协议版本，如 1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9._-]{0,62}[a-z0-9])?$"
    },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": ["image", "document", "media", "archive", "vector", "data", "other"]
    },
    "homepage": { "type": "string" },
    "license": { "type": "string" },
    "priority": { "type": "integer", "minimum": 0, "maximum": 1000, "default": 50 },
    "tags": { "type": "array", "items": { "type": "string" } },
    "icon": { "type": "string" },
    "runtime": {
      "type": "object",
      "required": ["type", "entry"],
      "additionalProperties": true,
      "properties": {
        "type": { "type": "string", "enum": ["python", "exec", "powershell", "node", "builtin"] },
        "entry": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "python": { "type": "string", "default": "auto" },
        "requires": { "type": "array", "items": { "type": "string" } },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "cwd": { "type": "string" }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["op", "from", "to"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "op": { "type": "string", "minLength": 1 },
          "from": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "to": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "multi_in": { "type": "boolean", "default": false },
          "multi_out": { "type": "boolean", "default": false },
          "label": { "type": "string" },
          "quality": { "type": "integer", "default": 0 },
          "output_mode": {
            "type": "string",
            "enum": ["exact", "prefix", "glob", "stdout"],
            "description": "产物落盘方式，见 PROTOCOL.md 第 8 节；缺省 exact"
          },
          "output_glob": {
            "type": "string",
            "description": "output_mode=glob 时的产物收集模板，支持 {outdir}/{stem}/{ext}/{output}"
          },
          "params": { "type": "array", "items": { "$ref": "#/definitions/param" } }
        }
      }
    },
    "params": { "type": "array", "items": { "$ref": "#/definitions/param" } },
    "probe": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["python-import", "command", "file", "none", "ckp-executable"]
        },
        "target": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "expect": { "type": "string" },
        "min_version": { "type": "string" }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "install": { "$ref": "#/definitions/hook" },
        "uninstall": { "$ref": "#/definitions/hook" }
      }
    },
    "builtin": {
      "type": "boolean",
      "description": "内置适配器标记（runtime.type = builtin 时由宿主实现）"
    }
  },
  "definitions": {
    "param": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["int", "float", "bool", "string", "enum", "path", "color"]
        },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "default": {},
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number" },
        "enum": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value"],
            "additionalProperties": true,
            "properties": {
              "value": {},
              "label": { "type": "string" }
            }
          }
        },
        "advanced": { "type": "boolean", "default": false },
        "required": { "type": "boolean", "default": false },
        "applies_to": { "type": "array", "items": { "type": "string" } },
        "when": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "from": { "type": "array", "items": { "type": "string" } },
            "to": { "type": "array", "items": { "type": "string" } },
            "op": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "hook": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": true,
      "properties": {
        "type": { "type": "string", "enum": ["command", "python", "url"] },
        "command": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "url": { "type": "string" },
        "description": { "type": "string" }
      }
    }
  }
}
