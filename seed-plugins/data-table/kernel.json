{
  "ckp": "1.0",
  "id": "data-table",
  "name": "表格数据内核",
  "version": "1.0.0",
  "kind": "data",
  "description": "CSV / TSV / JSON / XLSX / Markdown 表格 / HTML 表格 六种表格表示之间互转。Excel 读写由 openpyxl 提供，其余用标准库，完全离线。",
  "homepage": "https://github.com/ericgazoni/openpyxl",
  "license": "MIT",
  "priority": 50,
  "tags": ["data", "table", "csv", "tsv", "json", "xlsx", "excel", "markdown", "python"],
  "runtime": {
    "type": "python",
    "entry": "adapter.py",
    "requires": []
  },
  "probe": { "type": "none" },
  "capabilities": [
    {
      "id": "table.convert",
      "op": "convert",
      "label": "表格格式互转",
      "from": ["csv", "tsv", "json", "xlsx", "xlsm", "md", "markdown", "html", "htm", "text", "txt"],
      "to": ["csv", "tsv", "json", "xlsx", "md", "markdown", "html", "htm"]
    }
  ],
  "params": [
    { "id": "has_header", "type": "bool", "label": "首行是表头", "default": true,
      "description": "读取时是否把第一行当作字段名" },
    { "id": "write_header", "type": "bool", "label": "写出表头", "default": true },
    { "id": "delimiter", "type": "string", "label": "CSV 分隔符", "default": ",",
      "advanced": true, "when": { "to": ["csv", "text", "txt"] } },
    { "id": "sheet", "type": "string", "label": "工作表名",
      "description": "留空 = 第一个工作表", "default": "", "advanced": true },
    { "id": "indent", "type": "int", "label": "JSON 缩进", "default": 2,
      "min": 0, "max": 8, "advanced": true, "when": { "to": ["json"] } },
    { "id": "title", "type": "string", "label": "HTML 标题", "default": "",
      "when": { "to": ["html", "htm"] } }
  ],
  "hooks": {
    "install": {
      "type": "command", "command": "python",
      "args": ["tools/pip_bootstrap.py", "install", "--target", "vendor", "-i",
               "https://pypi.tuna.tsinghua.edu.cn/simple", "openpyxl"],
      "description": "安装 openpyxl（仅 XLSX 读写需要）"
    }
  }
}
